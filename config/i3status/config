general {
    colors = true
    interval = 5
    color_good     = "#00f0ff"
    color_degraded = "#00b8c4"
    color_bad      = "#ff3b5c"
    separator = "  "
}

order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "tztime local"

ethernet _first_ {
    format_up   = "  %ip"
    format_down = "  down"
}

cpu_usage {
    format = "  %usage"
    max_threshold = 85
}

memory {
    format = "  %used / %total"
    threshold_degraded = "1G"
    format_degraded = "  LOW %available"
}

disk "/" {
    format = "  %avail"
    low_threshold = 5
    threshold_type = percentage_avail
}

tztime local {
    format = "  %Y-%m-%d  %H:%M"
}
