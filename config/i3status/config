general {
    colors = true
    interval = 5
    color_good     = "#00f0ff"
    color_degraded = "#00b8c4"
    color_bad      = "#ff3b5c"
    separator = "  "
}

order += "read_file engagement"
order += "ethernet tun0"
order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "tztime local"

# engagement ativo (escrito pelo `engage`); some quando nao ha nenhum
read_file engagement {
    path = "~/.config/war_machine/engagement"
    format = "󰓾 %content"
    format_bad = ""
    color_good = "#ffb800"
}

# VPN de lab (HTB/THM/OSCP): o IP que vai no LHOST do reverse shell
ethernet tun0 {
    format_up   = "󰖂 %ip"
    format_down = ""
}

ethernet _first_ {
    format_up   = "  %ip"
    format_down = "  down"
}

cpu_usage {
    format = "  %usage"
    max_threshold = 85
}

memory {
    format = "  %used / %total"
    threshold_degraded = "1G"
    format_degraded = "  LOW %available"
}

disk "/" {
    format = "  %avail"
    low_threshold = 5
    threshold_type = percentage_avail
}

tztime local {
    format = "  %Y-%m-%d  %H:%M"
}
